# Copia este archivo a .env.local y completa los valores.
# Solo van claves PÚBLICAS: la "anon key" / "publishable key" es segura en el navegador
# porque todo está protegido por RLS y por funciones del servidor.
# NUNCA pongas aquí la service_role key.

# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_O_PUBLISHABLE_KEY

# URL pública del sitio (para el QR de los cupones). Si se omite se usa el origen actual.
VITE_SITE_URL=https://TU-PROYECTO.pages.dev
VITE_ENABLE_EMAIL=0   # 1 = muestra "Enviar a mi correo" (requiere docs/EMAIL.md)
